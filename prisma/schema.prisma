// Prisma 스키마: 데이터베이스 테이블(모델)을 정의하는 파일
// 고친 다음에는 `npm run db:migrate`로 실제 DB에 반영해요.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 사용자 테이블
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique // 같은 이메일로 두 번 가입할 수 없어요.
  password  String
  username  String
  createdAt DateTime @default(now())

  memos Memo[] // 이 사용자가 쓴 메모들 (1:N 관계)
}

// 메모 테이블
model Memo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String   @default("")
  createdAt DateTime @default(now())

  // 작성자: userId가 User.id를 가리켜요(외래 키).
  // 사용자를 지우면 그 사용자의 메모도 같이 지워져요(onDelete: Cascade).
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
