# 환경 변수 예시 파일
# 사용법: 이 파일을 복사해서 .env 를 만들고, 값을 내 컴퓨터에 맞게 바꿔요.
#   cp .env.example .env
# .env 는 git에 올라가지 않아요. 진짜 비밀번호는 .env 에만 적어요.

# PostgreSQL 접속 주소
# 형식: postgresql://사용자이름:비밀번호@호스트:포트/DB이름?schema=public
# - Homebrew로 설치한 PostgreSQL은 사용자이름 = 맥 계정 이름(터미널에서 whoami)
# - DB 만들기: createdb codeit_backend_live
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codeit_backend_live?schema=public"

# 연습용 DB (practice/ 폴더). DB 만들기: createdb codeit_practice
PRACTICE_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codeit_practice?schema=public"

# Better Auth 세션 서명에 쓰는 비밀 키 (아무도 모르는 긴 무작위 문자열)
# 만들기: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me"

# 이 백엔드 서버의 주소 (Better Auth가 쓰는 주소)
BETTER_AUTH_URL="http://localhost:3002"
